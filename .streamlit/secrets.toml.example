# Copie este archivo como .streamlit/secrets.toml para uso local,
# o pegue su contenido en Streamlit Cloud: App settings -> Secrets.
ADMIN_PASSWORD = "cambie-esta-clave"

# Base de datos PostgreSQL gratuita (Neon o Supabase). Sin esto, los datos se guardan
# en un archivo local que Streamlit Cloud borra cada vez que la app se reinicia.
DATABASE_URL = "postgresql://usuario:clave@servidor/base?sslmode=require"
